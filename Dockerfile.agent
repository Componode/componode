# Import Agent image for Componode (spec 025, ADR-116).
# Same monorepo build as the hub image; runs the agent runtime instead.
#
#   docker build -f Dockerfile.agent -t componode-agent:latest .
#
# The agent needs a state volume for its durable credential:
#   docker run -d --name componode-agent \
#     -e HUB_URL=https://hub.example.com \
#     -e AGENT_ENROLLMENT_TOKEN_FILE=/run/secrets/enroll_token \
#     -v ./enroll_token:/run/secrets/enroll_token:ro \
#     -v componode-agent-state:/state \
#     -e AGENT_STATE_DIR=/state \
#     componode-agent:latest

FROM node:24.21.0-alpine

RUN addgroup -g 10001 componode && \
    adduser -u 10001 -G componode -D componode

RUN corepack enable pnpm

WORKDIR /app

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm build

# /state must be writable by the agent user BEFORE dropping privileges —
# an anonymous/named volume initialized from this mountpoint keeps these
# ownership bits; without them persistToken fails EACCES on first enroll.
RUN mkdir -p /state && chown componode:componode /state

USER componode

ENV NODE_ENV=production \
    AGENT_STATE_DIR=/state

# Durable credential lives here — mount a volume so restarts don't re-enroll.
VOLUME ["/state"]

# Operations listener (spec 028): /healthz stays 200 through reconnect
# backoff; /readyz only reports ready while the hub stream is established.
# Operators who set AGENT_OPS_DISABLED=true must override this HEALTHCHECK
# (documented in docs/agents.md).
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "const h=process.env.AGENT_OPS_HOST;let host=h&&h!=='0.0.0.0'&&h!=='::'?h:'127.0.0.1';if(host.includes(':'))host='['+host+']';fetch('http://'+host+':'+(process.env.AGENT_OPS_PORT||'9464')+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "packages/agent/dist/main.js"]
