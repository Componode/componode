{
  "name": "componode",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source Digital Product Asset Management",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=@componode/*",
    "dev": "turbo run dev --filter=@componode/*",
    "test": "turbo run test --filter=@componode/*",
    "test:unit": "turbo run test:unit --filter=@componode/*",
    "test:integration": "turbo run test:integration --filter=@componode/*",
    "lint": "turbo run lint --filter=@componode/*",
    "typecheck": "turbo run typecheck --filter=@componode/*",
    "db:migrate": "pnpm --filter @componode/backend db:migrate",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^15.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitepress": "^1.6.4",
    "vitepress-openapi": "^0.2.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.15.2",
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "^1.1.21",
      "fast-uri@^3": "^3.1.7",
      "fast-uri@^4": "^4.1.4",
      "js-yaml@^4": "^4.3.2",
      "source-map-js@<1.2.2": "^1.2.2",
      "vitepress>vite": "^7.3.6",
      "vitepress>@vitejs/plugin-vue": "^6.0.9",
      "vite@^7>esbuild": "^0.28.1",
      "@types/react": "^19.3.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "main": "eslint.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Componode/componode.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/Componode/componode/issues"
  },
  "homepage": "https://github.com/Componode/componode#readme"
}
