{
  "name": "componode",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source Digital Product Asset Management",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=@componode/*",
    "dev": "turbo run dev --filter=@componode/*",
    "test": "turbo run test --filter=@componode/*",
    "test:unit": "turbo run test:unit --filter=@componode/*",
    "test:integration": "turbo run test:integration --filter=@componode/*",
    "lint": "turbo run lint --filter=@componode/*",
    "typecheck": "turbo run typecheck --filter=@componode/*",
    "db:migrate": "pnpm --filter @componode/backend db:migrate",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.13.4",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.3.6",
    "vitepress": "^1.6.4",
    "vitepress-openapi": "^0.2.4",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@9.15.2",
  "pnpm": {
    "overrides": {
      "fast-uri@^3": "^3.1.7",
      "fast-uri@^4": "^4.1.4",
      "js-yaml@^4": "^4.3.2"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "main": "eslint.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Componode/componode.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/Componode/componode/issues"
  },
  "homepage": "https://github.com/Componode/componode#readme"
}
