    "test:unit": "vitest run"
  },
  "dependencies": {
    "@alicloud/bssopenapi20171214": "^4.1.1",
    "@alicloud/openapi-core": "^1.0.8",
    "@alicloud/resourcecenter20221201": "^1.6.0",
    "@alicloud/sts20150401": "^1.2.0",
    "@componode/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
