{
  "name": "@componode/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/db/run-migrations.ts",
    "docs:api": "tsx scripts/generate-api-doc.ts",
    "docs:api:check": "tsx scripts/generate-api-doc.ts --check",
    "docs:importers": "tsx scripts/generate-importer-docs.ts",
    "docs:importers:check": "tsx scripts/generate-importer-docs.ts --check",
    "docs:sidebar:check": "tsx scripts/check-docs-sidebar.ts",
    "docs:schema": "tsx scripts/generate-schema-doc.ts",
    "docs:schema:check": "tsx scripts/generate-schema-doc.ts --check",
    "docs:oracle:check": "tsx scripts/check-docs-oracle.ts"
  },
  "dependencies": {
    "@componode/core": "workspace:*",
    "@componode/importer-alibaba-cloud": "workspace:*",
    "@componode/importer-api-url": "workspace:*",
    "@componode/importer-aws": "workspace:*",
    "@componode/importer-azure": "workspace:*",
    "@componode/importer-docker": "workspace:*",
    "@componode/importer-github": "workspace:*",
    "@componode/importer-kubernetes": "workspace:*",
    "@componode/importer-mcp-server": "workspace:*",
    "@componode/importer-web-url": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.10.0",
    "fastify": "^5.12.8",
    "kysely": "^0.29.8",
    "node-cron": "^4.6.0",
    "openid-client": "^6.8.9",
    "p-queue": "^10.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "jose": "^6.2.13",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  }
}
