{
  "name": "@componode/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/db/run-migrations.ts",
    "docs:api": "tsx scripts/generate-api-doc.ts",
    "docs:api:check": "tsx scripts/generate-api-doc.ts --check"
  },
  "dependencies": {
    "@componode/core": "workspace:*",
    "@componode/importer-api-url": "workspace:*",
    "@componode/importer-aws": "workspace:*",
    "@componode/importer-azure": "workspace:*",
    "@componode/importer-github": "workspace:*",
    "@componode/importer-kubernetes": "workspace:*",
    "@componode/importer-mcp-server": "workspace:*",
    "@componode/importer-web-url": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.0",
    "fastify": "^5.12.4",
    "kysely": "^0.29.5",
    "node-cron": "^4.6.0",
    "openid-client": "^6.8.5",
    "p-queue": "^8.0.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "uuidv7": "^1.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.11.10",
    "jose": "^6.2.12",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "yaml": "^2.9.0"
  }
}
