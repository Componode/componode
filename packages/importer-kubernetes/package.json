{
  "name": "@componode/importer-kubernetes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./importer": {
      "types": "./dist/importer.d.ts",
      "import": "./dist/importer.js"
    }
  },
  "scripts": {
