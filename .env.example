# Componode self-hosted deployment configuration
# Copy this file to .env and edit the values before running `docker compose up -d`.

# Application port on the host
PORT=3000

# Database connection
# The default uses the postgres service defined in docker-compose.yml.
DATABASE_URL=postgres://componode:componode_pw@postgres:5432/componode
# DATABASE_SSL_MODE defaults to `require` in production. The bundled Compose
# Postgres has no TLS configured, so it is disabled explicitly here. For a
# remote Postgres use `require`, or `verify-full` together with
# DATABASE_SSL_CA=/path/to/ca.pem.
DATABASE_SSL_MODE=disable
# DATABASE_SSL_CA=
MAX_DB_CONNECTIONS=10

# Bundled Caddy HTTPS front end (ADR-093)
# TLS is terminated by the caddy service with a self-signed certificate
# from Caddy's internal CA. SITE_ADDRESS is the public name the cert is
# issued for — set it to this host's DNS name or IP so it matches what
# clients connect to. HTTP_PORT/HTTPS_PORT are the host ports Caddy binds;
# the app's own :3000 stays bound to loopback.
SITE_ADDRESS=localhost
# HTTP_PORT=80
# HTTPS_PORT=443

# Reverse proxy trust (ADR-093)
# The bundled Caddy fronts the app, so the stack defaults this to 1 (one
# trusted proxy hop). Set it empty to ignore X-Forwarded-* headers when no
# proxy fronts the app, or a proxy IP / comma-separated list / hop count
# when fronting with a different proxy.
# TRUSTED_PROXY_IP=

# Canonical public base URL (e.g., https://componode.example.com). Used to
# build the OIDC callback URL — set it to https://<SITE_ADDRESS> when the
# app runs behind a reverse proxy. Defaults to the request's origin.
# PUBLIC_URL=https://localhost

# Cross-origin access is disabled by default (ADR-088). To allow a separate
# frontend origin to call the API with credentials, set a comma-separated
# list of exact origins.
# CORS_ALLOWED_ORIGINS=https://componode.example.com

# File-based secret references (importer configs, OIDC client secret)
# `file:` secret refs resolve relative to this directory; absolute paths and
# traversal outside it are rejected. Defaults to /run/secrets.
# SECRETS_DIR=/run/secrets

# Session cookie secret
# Generate a strong, random value for production.
COOKIE_SECRET=change-me-in-production

# Initial admin credentials
# The bootstrap admin is created on first startup.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# OIDC single sign-on is configured in the app (Settings → OIDC
# Configuration), not via environment variables. See docs/deployment.md.

# Node environment
NODE_ENV=production

# Logging
LOG_LEVEL=info

# Maximum importer runs executing in parallel
# IMPORTER_MAX_CONCURRENCY=3

# Optional: canonical base URI for RFC 7807 problem `type` fields.
# Defaults to https://componode.io if unset.
# PROBLEM_TYPE_BASE=https://componode.io

# Import Agent (optional)
# The `agent` service builds together with the app but starts 0 replicas —
# agents normally run on remote hosts (see docs/agents.md). To run a
# co-located agent against this stack, set the one-time enrollment token
# from Administration → Import Agents, then:
#   docker compose up -d --scale agent=1
# The agent reaches the hub through Caddy at https://hub and verifies the
# self-signed certificate against Caddy's internal root CA, mounted
# read-only from the caddy_data volume as CA_BUNDLE.
# AGENT_ENROLLMENT_TOKEN=
# HUB_URL=https://hub
